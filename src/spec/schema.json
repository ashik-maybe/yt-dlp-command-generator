{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yt-dlp tool spec",
  "type": "object",
  "required": ["tool", "version", "options"],
  "properties": {
    "tool": { "type": "string" },
    "version": { "type": "string" },
    "pinnedVersion": { "type": "string" },
    "helpFile": { "type": "string" },
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" }
    },
    "deprecated": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["flag"],
      "properties": {
        "flag": { "type": "string" },
        "metavar": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" } },
        "default": { "type": "string" },
        "anchor": { "type": "string" },
        "isBoolean": { "type": "boolean" }
      }
    }
  }
}
